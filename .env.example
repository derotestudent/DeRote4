# ==============================================================================
# DeRote Student Insight System — Environment Configuration
# ==============================================================================
# All variables prefixed with VITE_ are embedded into the client bundle at build time.
# Obtain these values from:
# Firebase Console -> Project Settings -> General -> Your apps -> Web app config
# ==============================================================================

# Required: Firebase Web Client API Key (identifies project to Google APIs)
VITE_FIREBASE_API_KEY=AIzaSyANTvGAKGqFadWROYMlElR6EDxtA1XaXtk

# Required: Firebase Auth Domain (must also be added to Authorized Domains in Firebase Auth settings)
VITE_FIREBASE_AUTH_DOMAIN=gen-lang-client-0276070718.firebaseapp.com

# Required: Google Cloud / Firebase Project ID
VITE_FIREBASE_PROJECT_ID=gen-lang-client-0276070718

# Required: Cloud Storage bucket URL for file attachments (if utilized)
VITE_FIREBASE_STORAGE_BUCKET=gen-lang-client-0276070718.firebasestorage.app

# Required: Firebase Cloud Messaging / Project Number sender ID
VITE_FIREBASE_MESSAGING_SENDER_ID=558600646882

# Required: Firebase Web Application registered App ID
VITE_FIREBASE_APP_ID=1:558600646882:web:d6c592c2d0ad3fbfb5aebb

# Optional: Google Analytics 4 Measurement ID
VITE_FIREBASE_MEASUREMENT_ID=G-4XSMGZKH1X